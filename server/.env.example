NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/promise_to_palestine
# DATABASE_SSL=true
JWT_SECRET=replace-with-a-long-random-string
CLIENT_URL=http://localhost:5173
CAMPAIGN_SLUG=promise-to-palestine

# Real payments (recommended): Stripe Checkout
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Local development only: completes pledges instantly with NO real payment.
DEMO_PAYMENTS=true

# Used by `npm run seed` to create the admin login (12+ chars)
ADMIN_EMAIL=
ADMIN_PASSWORD=
