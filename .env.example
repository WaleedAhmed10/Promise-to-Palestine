# Copy this file to .env and fill it in. Never commit .env.

# --- Server -------------------------------------------------------------
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://promise:promise@localhost:5432/promise
# Set to true for hosted databases that require TLS (Render, Neon, Supabase...)
DATABASE_SSL=false
# Public address of the site. Stripe sends donors back here.
CLIENT_URL=http://localhost:5173
# Number of reverse proxies in front of the server (1 on Render, Railway, Fly...)
TRUST_PROXY=0

# --- Payments -----------------------------------------------------------
# demo   = no real money moves. Development only; the server refuses to start in production.
# stripe = real payments through Stripe Checkout.
PAYMENT_MODE=demo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Admin (/admin) -----------------------------------------------------
# Leave ADMIN_PASSWORD empty to switch the admin area off.
ADMIN_PASSWORD=change-me-please-12
# At least 32 random characters in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# --- Site details (all optional) ----------------------------------------
# Name of the relief organisation that delivers the aid. Shown in the footer.
PARTNER_NAME=
# Public contact address shown in the footer.
CONTACT_EMAIL=
# Smallest and largest single gift, in cents.
MIN_DONATION_CENTS=300
MAX_DONATION_CENTS=1000000
